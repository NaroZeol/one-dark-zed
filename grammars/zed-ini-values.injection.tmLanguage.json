{
  "name": "Zed INI value corrections",
  "scopeName": "zed.one-dark.ini-values",
  "injectionSelector": "L:source.ini -comment",
  "patterns": [
    {
      "match": "(?<==)\\s*([^#;\\r\\n]+?)(?=\\s*(?:[#;]|$))",
      "captures": {
        "1": { "name": "string.unquoted.ini.zed" }
      }
    }
  ]
}
