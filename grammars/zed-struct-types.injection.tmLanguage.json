{
  "name": "Zed C and Rust syntax corrections",
  "scopeName": "zed.one-dark.struct-types",
  "injectionSelector": "L:source.c -comment -string, L:source.rust -comment -string",
  "patterns": [
    {
      "match": "(?<=\\bstruct\\s)[A-Za-z_][A-Za-z_0-9]*",
      "name": "entity.name.type.zed"
    },
    {
      "match": "(?<=\\bunion\\s)[A-Za-z_][A-Za-z_0-9]*",
      "name": "entity.name.type.zed"
    },
    {
      "match": "(?<=\\benum\\s)[A-Za-z_][A-Za-z_0-9]*",
      "name": "entity.name.type.zed"
    },
    {
      "match": "(?<=[(,])\\s*[A-Za-z_][A-Za-z_0-9]*(?=\\s*:)",
      "name": "variable.parameter.zed"
    }
  ]
}
