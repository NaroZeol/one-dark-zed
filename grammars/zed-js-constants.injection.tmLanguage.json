{
  "name": "Zed JavaScript and TypeScript constant corrections",
  "scopeName": "zed.one-dark.js-constants",
  "injectionSelector": "L:source.js -comment -string, L:source.js.jsx -comment -string, L:source.ts -comment -string -meta.type, L:source.tsx -comment -string -meta.type",
  "patterns": [
    {
      "match": "\\b_*[A-Z_][A-Z\\d_]*\\b",
      "name": "variable.other.constant.zed"
    }
  ]
}
