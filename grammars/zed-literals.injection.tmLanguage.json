{
  "name": "Zed JSON and SQL literal corrections",
  "scopeName": "zed.one-dark.literals",
  "injectionSelector": "L:source.json -comment -string, L:source.json.comments -comment -string, L:source.json.lines -comment -string, L:source.sql -comment -string",
  "patterns": [
    {
      "match": "(?i:\\b(?:true|false)\\b)",
      "name": "constant.language.boolean.zed"
    },
    {
      "match": "(?i:\\bnull\\b)",
      "name": "constant.language.null.zed"
    }
  ]
}
