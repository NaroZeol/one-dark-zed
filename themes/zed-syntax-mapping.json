{
  "semanticTokenColors": {
    "namespace": { "foreground": "#dce0e5ff" },
    "type": { "foreground": "#6eb4bfff" },
    "class": { "foreground": "#6eb4bfff" },
    "enum": { "foreground": "#6eb4bfff" },
    "interface": { "foreground": "#6eb4bfff" },
    "struct": { "foreground": "#6eb4bfff" },
    "typeParameter": { "foreground": "#6eb4bfff" },
    "parameter": { "foreground": "#d07277ff" },
    "variable": { "foreground": "#acb2beff" },
    "property": { "foreground": "#d07277ff" },
    "enumMember": { "foreground": "#73ade9ff" },
    "event": { "foreground": "#73ade9ff" },
    "function": { "foreground": "#73ade9ff" },
    "method": { "foreground": "#73ade9ff" },
    "macro": { "foreground": "#b477cfff" },
    "label": { "foreground": "#74ade8ff" },
    "comment": { "foreground": "#5d636fff" },
    "string": { "foreground": "#a1c181ff" },
    "keyword": { "foreground": "#b477cfff" },
    "number": { "foreground": "#bf956aff" },
    "regexp": { "foreground": "#bf956aff" },
    "operator": { "foreground": "#6eb4bfff" },
    "decorator": { "foreground": "#74ade8ff" },
    "variable.readonly": { "foreground": "#dfc184ff" },
    "property.readonly": { "foreground": "#dfc184ff" },
    "variable.defaultLibrary": { "foreground": "#bf956aff" },
    "function.defaultLibrary": { "foreground": "#73ade9ff" },
    "method.defaultLibrary": { "foreground": "#73ade9ff" },
    "type.defaultLibrary": { "foreground": "#6eb4bfff" }
  },
  "tokenColors": [
    {
      "name": "Zed: comments",
      "scope": ["comment"],
      "settings": { "foreground": "#5d636fff" }
    },
    {
      "name": "Zed: documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": { "foreground": "#878e98ff" }
    },
    {
      "name": "Zed: keywords and declarations",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.control.directive",
        "keyword.other.directive"
      ],
      "settings": { "foreground": "#b477cfff" }
    },
    {
      "name": "Zed: operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": { "foreground": "#6eb4bfff" }
    },
    {
      "name": "Zed: punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#acb2beff" }
    },
    {
      "name": "Zed: brackets and delimiters",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "punctuation.definition.typeparameters",
        "punctuation.section",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#b2b9c6ff" }
    },
    {
      "name": "Zed: special punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation",
        "punctuation.separator.key-value",
        "keyword.operator.type.annotation",
        "keyword.operator.optional"
      ],
      "settings": { "foreground": "#b1574bff" }
    },
    {
      "name": "Zed: strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated",
        "string.quoted.raw",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#a1c181ff" }
    },
    {
      "name": "Zed: string escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "string.escape"
      ],
      "settings": { "foreground": "#878e98ff" }
    },
    {
      "name": "Zed: regular expressions and special strings",
      "scope": [
        "string.regexp",
        "string.regex",
        "constant.other.character-class",
        "constant.character.numeric.regexp",
        "keyword.operator.quantifier.regexp",
        "constant.other.symbol",
        "string.other.link"
      ],
      "settings": { "foreground": "#bf956aff" }
    },
    {
      "name": "Zed: numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": { "foreground": "#bf956aff" }
    },
    {
      "name": "Zed: named constants",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "constant.other"
      ],
      "settings": { "foreground": "#dfc184ff" }
    },
    {
      "name": "Zed: types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.type.parameter",
        "support.type",
        "support.class",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean",
        "storage.type.primitive"
      ],
      "settings": { "foreground": "#6eb4bfff" }
    },
    {
      "name": "Zed: constructors and enum variants",
      "scope": [
        "entity.name.function.constructor",
        "entity.name.type.variant",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#73ade9ff" }
    },
    {
      "name": "Zed: functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "meta.method-call entity.name.function",
        "meta.method-call variable.function"
      ],
      "settings": { "foreground": "#73ade9ff" }
    },
    {
      "name": "Zed: parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "meta.function.definition variable.parameter"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "meta.object-binding-pattern-variable meta.definition.variable",
        "string.json support.type.property-name.json"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: attributes and decorators",
      "scope": [
        "entity.other.attribute-name",
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "meta.attribute entity.name"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: namespaces and packages",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.package",
        "support.other.namespace",
        "variable.other.namespace"
      ],
      "settings": { "foreground": "#dce0e5ff" }
    },
    {
      "name": "Zed: labels",
      "scope": [
        "entity.name.label",
        "entity.name.section",
        "variable.other.label"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: special variables",
      "scope": [
        "variable.language",
        "variable.other.this",
        "variable.other.super",
        "variable.other.object.self"
      ],
      "settings": { "foreground": "#bf956aff" }
    },
    {
      "name": "Zed: CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.name.tag.scss"
      ],
      "settings": { "foreground": "#dfc184ff" }
    },
    {
      "name": "Zed: CSS pseudo selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#bf956aff", "fontStyle": "bold" }
    },
    {
      "name": "Zed: markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#74ade8ff", "fontStyle": "italic" }
    },
    {
      "name": "Zed: markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link.description",
        "meta.link.inline.markdown string"
      ],
      "settings": { "foreground": "#73ade9ff", "fontStyle": "italic" }
    },
    {
      "name": "Zed: markup link targets",
      "scope": [
        "markup.underline.link.image",
        "meta.link.inline.markdown string.other.link"
      ],
      "settings": { "foreground": "#6eb4bfff" }
    },
    {
      "name": "Zed: markup literals",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.quote"
      ],
      "settings": { "foreground": "#a1c181ff" }
    },
    {
      "name": "Zed: markup list markers",
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition.list"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#98c379ff" }
    },
    {
      "name": "Zed: diff removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#e06c75ff" }
    },
    {
      "name": "Zed: invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#d07277ff" }
    }
  ]
}
