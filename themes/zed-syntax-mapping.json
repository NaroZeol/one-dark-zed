{
  "semanticTokenColors": {
    "namespace": { "foreground": "#dce0e5ff" },
    "type": { "foreground": "#6eb4bfff" },
    "class": { "foreground": "#6eb4bfff" },
    "enum": { "foreground": "#6eb4bfff" },
    "interface": { "foreground": "#6eb4bfff" },
    "struct": { "foreground": "#6eb4bfff" },
    "typeParameter": { "foreground": "#6eb4bfff" },
    "parameter": { "foreground": "#d07277ff" },
    "variable": { "foreground": "#acb2beff" },
    "property": { "foreground": "#d07277ff" },
    "enumMember": { "foreground": "#73ade9ff" },
    "event": { "foreground": "#6eb4bfff" },
    "function": { "foreground": "#73ade9ff" },
    "method": { "foreground": "#73ade9ff" },
    "macro": { "foreground": "#73ade9ff" },
    "label": { "foreground": "#74ade8ff" },
    "comment.documentation": { "foreground": "#878e98ff" },
    "comment": { "foreground": "#5d636fff" },
    "string.documentation": { "foreground": "#a1c181ff" },
    "string": { "foreground": "#a1c181ff" },
    "keyword": { "foreground": "#b477cfff" },
    "number": { "foreground": "#bf956aff" },
    "regexp": { "foreground": "#bf956aff" },
    "operator": { "foreground": "#6eb4bfff" },
    "decorator": { "foreground": "#74ade8ff" },
    "modifier": { "foreground": "#b477cfff" },
    "variable.readonly": { "foreground": "#dfc184ff" },
    "variable.constant": { "foreground": "#dfc184ff" },
    "property.readonly": { "foreground": "#d07277ff" },
    "variable.defaultLibrary": { "foreground": "#acb2beff" },
    "function.defaultLibrary": { "foreground": "#73ade9ff" },
    "method.defaultLibrary": { "foreground": "#73ade9ff" },
    "type.defaultLibrary": { "foreground": "#6eb4bfff" }
  },
  "tokenColors": [
    {
      "name": "Zed: comments",
      "scope": [
        "comment",
        "comment punctuation.definition.comment",
        "comment.line.rem.batchfile keyword.command.rem.batchfile",
        "string.comment.buffered.block.pug"
      ],
      "settings": { "foreground": "#5d636fff" }
    },
    {
      "name": "Zed: documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": { "foreground": "#878e98ff" }
    },
    {
      "name": "Zed: keywords and declarations",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.struct",
        "storage.type.enum",
        "storage.type.namespace",
        "storage.type.typedef",
        "storage.type.js",
        "storage.type.jsx",
        "storage.type.ts",
        "storage.type.tsx",
        "storage.type.modifier",
        "meta.function.powershell storage.type.powershell",
        "meta.function.perl storage.type.sub.perl",
        "meta.function.section.section.latex support.function.section.latex",
        "meta.commit-command.git-rebase support.function.git-rebase",
        "storage.type.structure.shaderlab",
        "storage.type.declare.routine.perl",
        "storage.type.asp",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.control.directive",
        "keyword.other.directive"
      ],
      "settings": { "foreground": "#b477cfff" }
    },
    {
      "name": "Zed: operators",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "storage.type.function.coffee"
      ],
      "settings": { "foreground": "#6eb4bfff" }
    },
    {
      "name": "Zed: punctuation",
      "scope": ["punctuation"],
      "settings": { "foreground": "#acb2beff" }
    },
    {
      "name": "Zed: brackets and delimiters",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.array",
        "punctuation.definition.dictionary",
        "punctuation.definition.group",
        "punctuation.definition.character-class",
        "punctuation.definition.tag",
        "punctuation.definition.typeparameters",
        "punctuation.definition.entity.css",
        "punctuation.definition.entity.scss",
        "punctuation.section",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#b2b9c6ff" }
    },
    {
      "name": "Zed: special punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation",
        "punctuation.definition.decorator",
        "punctuation.definition.variable.shell",
        "punctuation.section.bracket.curly.variable.begin.shell",
        "punctuation.section.bracket.curly.variable.end.shell",
        "punctuation.definition.evaluation.backticks.shell"
      ],
      "settings": { "foreground": "#b1574bff" }
    },
    {
      "name": "Zed: strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated",
        "string.quoted.raw",
        "entity.name.import.go",
        "constant.other.rune.go",
        "punctuation.definition.string",
        "meta.key-assignment.bibtex"
      ],
      "settings": { "foreground": "#a1c181ff" }
    },
    {
      "name": "Zed: string escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "string.escape"
      ],
      "settings": { "foreground": "#878e98ff" }
    },
    {
      "name": "Zed: regular expressions and special strings",
      "scope": [
        "string.regexp",
        "string.regex",
        "string.regexp punctuation.definition.string",
        "constant.other.character-class",
        "constant.character.numeric.regexp",
        "keyword.operator.quantifier.regexp",
        "constant.other.placeholder",
        "constant.other.symbol",
        "constant.other.color.rgb-value.hex.css",
        "constant.other.color.rgb-value.hex.scss",
        "constant.other.color.rgb-value.less",
        "constant.other.color.rgb-value.less punctuation.definition.constant.less",
        "constant.other.color.rgb-value.css",
        "constant.other.color.rgb-value.hex.css punctuation.definition.constant.css",
        "string.other.link"
      ],
      "settings": { "foreground": "#bf956aff" }
    },
    {
      "name": "Zed: numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "punctuation.separator.constant.numeric"
      ],
      "settings": { "foreground": "#bf956aff" }
    },
    {
      "name": "Zed: named constants",
      "scope": [
        "entity.name.constant",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.iota",
        "support.constant",
        "entity.name.other.preprocessor.macro.predefined",
        "constant.other",
        "string.interpolated.makefile variable.other.makefile"
      ],
      "settings": { "foreground": "#dfc184ff" }
    },
    {
      "name": "Zed: types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.type.parameter",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "keyword.type",
        "keyword.other.type",
        "storage.type.powershell",
        "storage.type",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean",
        "storage.type.primitive",
        "entity.name.section.group-title.ini"
      ],
      "settings": { "foreground": "#6eb4bfff" }
    },
    {
      "name": "Zed: constructors and enum variants",
      "scope": [
        "entity.name.function.constructor",
        "entity.name.type.variant",
        "variable.other.enummember",
        "entity.name.variable.enum-member"
      ],
      "settings": { "foreground": "#73ade9ff" }
    },
    {
      "name": "Zed: functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "meta.method-call entity.name.function",
        "meta.method-call variable.function",
        "meta.function-call.python",
        "binding.fsharp variable.fsharp",
        "meta.definition.global.clojure entity.global.clojure"
      ],
      "settings": { "foreground": "#73ade9ff" }
    },
    {
      "name": "Zed: variables",
      "scope": [
        "variable",
        "meta.function.inline.other.handlebars variable.parameter.handlebars"
      ],
      "settings": { "foreground": "#acb2beff" }
    },
    {
      "name": "Zed: parameters",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "meta.function.parameters variable",
        "meta.function.definition variable.parameter"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: properties",
      "scope": [
        "variable.other.property",
        "variable.other.field",
        "variable.object.property",
        "variable.other.object.property",
        "variable.other.constant.property",
        "variable.other.constant.object.property",
        "entity.name.variable.field",
        "entity.name.variable.property",
        "entity.name.variable.tuple-element",
        "entity.other.attribute.lua",
        "meta.attribute.python",
        "support.variable.property",
        "support.type.property-name",
        "punctuation.support.type.property-name",
        "keyword.other.definition.ini",
        "entity.name.tag.yaml",
        "entity.name.tag.yaml punctuation.definition.string",
        "meta.object-literal.key",
        "meta.object-binding-pattern-variable meta.definition.variable",
        "string.json support.type.property-name.json",
        "support.variable.declaration.shaderlab",
        "support.function.key.bibtex"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: attributes and decorators",
      "scope": [
        "entity.other.attribute-name",
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "meta.attribute entity.name"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: tags",
      "scope": [
        "entity.name.tag",
        "meta.tag support.class.component"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: namespaces and packages",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.package",
        "variable.other.import.go",
        "support.other.namespace",
        "variable.other.namespace",
        "entity.name.scope-resolution.cpp",
        "entity.scope.name.objcpp"
      ],
      "settings": { "foreground": "#dce0e5ff" }
    },
    {
      "name": "Zed: labels",
      "scope": [
        "entity.name.label",
        "entity.name.section",
        "variable.other.label.go",
        "variable.other.label"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: special variables",
      "scope": [
        "variable.language",
        "variable.other.this",
        "variable.other.super",
        "variable.other.object.self"
      ],
      "settings": { "foreground": "#bf956aff" }
    },
    {
      "name": "Zed: CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.id.scss",
        "entity.name.tag.css",
        "entity.name.tag.scss"
      ],
      "settings": { "foreground": "#dfc184ff" }
    },
    {
      "name": "Zed: CSS pseudo selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "entity.other.attribute-name.pseudo-class.scss",
        "entity.other.attribute-name.pseudo-element.scss"
      ],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown",
        "meta.function.section.section.latex entity.name.section.latex"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#bf956aff", "fontStyle": "bold" }
    },
    {
      "name": "Zed: markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#74ade8ff" }
    },
    {
      "name": "Zed: markup links",
      "scope": [
        "string.other.link.description",
        "meta.link.inline.markdown string.other.link.title",
        "meta.link.inline.markdown punctuation.definition.link.title"
      ],
      "settings": { "foreground": "#73ade9ff", "fontStyle": "italic" }
    },
    {
      "name": "Zed: markup link targets",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image",
        "meta.link.inline.markdown string.other.link",
        "meta.link.inline.markdown punctuation.definition.metadata"
      ],
      "settings": { "foreground": "#6eb4bfff" }
    },
    {
      "name": "Zed: markup literals",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown",
        "markup.raw.block.markdown",
        "markup.fenced_code.block.markdown",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": { "foreground": "#a1c181ff" }
    },
    {
      "name": "Zed: markup punctuation",
      "scope": [
        "punctuation.definition.quote.begin.markdown",
        "punctuation.definition.table.markdown",
        "punctuation.separator.table.markdown"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: markup list markers",
      "scope": [
        "punctuation.definition.list",
        "markup.list punctuation.definition.list"
      ],
      "settings": { "foreground": "#d07277ff" }
    },
    {
      "name": "Zed: diff added",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#98c379ff" }
    },
    {
      "name": "Zed: diff removed",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#e06c75ff" }
    },
    {
      "name": "Zed: invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#d07277ff" }
    }
  ]
}
