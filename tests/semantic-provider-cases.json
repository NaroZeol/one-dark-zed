        "sampleapi/types.go": "package sampleapi\n\ntype AlphaInput struct{}\ntype AlphaOutput struct{}\ntype BetaInput struct{}\ntype BetaOutput struct{}\ntype GammaInput struct{}\ntype GammaOutput struct{}\n\nfunc Build(AlphaInput) AlphaOutput { return AlphaOutput{} }\n",
        "theme.go": "package theme\n\nimport \"example.com/zed-semantics/sampleapi\"\n\nconst MaxRetries = 3\n\ntype LocalAlphaInput sampleapi.AlphaInput\ntype LocalAlphaOutput sampleapi.AlphaOutput\ntype LocalBetaInput sampleapi.BetaInput\ntype LocalBetaOutput sampleapi.BetaOutput\ntype LocalGammaInput sampleapi.GammaInput\ntype LocalGammaOutput sampleapi.GammaOutput\n\ntype holder struct { value int }\n\nfunc (receiver *holder) assign(target, source holder, amount int) int {\n\ttarget.value = source.value\n\treceiver.value = target.value + amount\n\treturn receiver.value\n}\n\nfunc missing(err error) bool {\n\treturn err != nil\n}\n\nfunc builtins(items []int) bool {\n\tempty := len(items) == 0\n\treturn empty || true || false\n}\n\nfunc consume(input sampleapi.AlphaInput) sampleapi.AlphaOutput {\n\treturn sampleapi.Build(input)\n}\n",
        "callable.go": "package theme\n\nfunc makeCleanup() func() { return func() {} }\n\nfunc scheduleCleanup() {\n\tcleanup := makeCleanup()\n\tdefer cleanup()\n}\n\nfunc invoke(callback func()) {\n\tcallback()\n}\n\ntype closer struct { onClose func() }\n\nfunc (value *closer) close() {\n\tvalue.onClose()\n}\n",
        "format.go": "package theme\n\nimport \"fmt\"\n\nfunc render(value int) string {\n\treturn fmt.Sprintf(\"value=%d\", value)\n}\n",
        "switch.go": "package theme\n\nimport \"net/http\"\n\ntype requestView struct { Method string }\ntype upgrade struct { TargetVersion string; State string }\n\nfunc route(r requestView, data *upgrade) string {\n\tswitch r.Method {\n\tcase http.MethodPost:\n\t\tdata.State = \"post\"\n\tdefault:\n\t\tdata.State = \"other\"\n\t}\n\tdata.TargetVersion = http.MethodGet\n\tresult := upgrade{TargetVersion: data.TargetVersion}\n\treturn result.TargetVersion\n}\n"
      },
