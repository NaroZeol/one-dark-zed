        "tsconfig.json": "{\"compilerOptions\":{\"strict\":true,\"target\":\"ES2022\"}}\n",
        "theme.ts": "namespace Domain {\n  export interface Item { value: number }\n  export const MAX_RETRIES = 3\n  export function make(input: Item): Item {\n    return { value: input.value }\n  }\n}\n\nclass Store {\n  private current: Domain.Item\n  update(next: Domain.Item): Domain.Item {\n    this.current.value = next.value\n    return Domain.make(this.current)\n  }\n}\n\nenum Status { Ready, Stopped }\nclass Config { readonly label = \"theme\" }\nasync function load(): Promise<number> {\n  console.log(Status.Ready)\n  return Promise.resolve(1)\n}\n\ntype Callback = (value: number) => number\nfunction invokeCallback(callback: Callback): number {\n  const local = callback\n  return local(1)\n}\nconst arrow = (value: number) => value + 1\narrow(2)\n",
        "theme.js": "/** @class */\nclass Holder {\n  constructor(value) { this.value = value }\n  assign(other, amount) {\n    this.value = other.value + amount\n    return this.value\n  }\n}\n\nfunction build(input) { return new Holder(input.value) }\n\nfunction invokeCallback(callback) {\n  const local = callback\n  return local(1)\n}\nconst arrow = (value) => value + 1\narrow(2)\n"
      },
