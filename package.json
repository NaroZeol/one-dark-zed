{
  "name": "onedark-zed",
  "displayName": "OneDark Zed",
  "description": "A dark theme inspired by One Dark and Zed.",
  "version": "1.0.2",
  "publisher": "premier213",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/premier213/one-dark-zed.git"
  },
  "homepage": "https://github.com/premier213/one-dark-zed",
  "bugs": {
    "url": "https://github.com/premier213/one-dark-zed/issues"
  },
  "keywords": [
    "icon-theme",
    "theme",
    "dark-pro",
    "onedark",
    "onedark-zed",
    "onedark-zed-icons",
    "onedark-zed-color-theme",
    "onedark-zed-icon-theme",
    "onedark-zed-color-theme.json",
    "onedark-zed-icon-theme.json",
    "onedark-zed-color-theme.json",
    "zed"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "ovsx publish",
    "publish:vscode": "vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "Onedark Zed",
        "uiTheme": "vs-dark",
        "path": "./themes/onedark-zed-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "onedark-zed-icons",
        "label": "Onedark Zed Icons",
        "path": "./icons/onedark-zed-icon-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1"
  },
  "dependencies": {
    "ovsx": "^0.10.12"
  }
}
