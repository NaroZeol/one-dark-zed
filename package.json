{
  "name": "onedark-zed-local",
  "displayName": "OneDark Zed Local",
  "description": "A locally maintained VS Code port aligned with Zed's official One Dark theme.",
  "version": "1.0.6-local.1",
  "publisher": "NaroZeol",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/premier213/one-dark-zed.git"
  },
  "homepage": "https://github.com/premier213/one-dark-zed",
  "bugs": {
    "url": "https://github.com/premier213/one-dark-zed/issues"
  },
  "keywords": [
    "icon-theme",
    "theme",
    "dark-pro",
    "onedark",
    "onedark-zed",
    "onedark-zed-icons",
    "onedark-zed-color-theme",
    "onedark-zed-icon-theme",
    "onedark-zed-color-theme.json",
    "onedark-zed-icon-theme.json",
    "onedark-zed-color-theme.json",
    "zed"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "sync:theme": "bash scripts/apply-zed-syntax-map.sh",
    "test": "bash scripts/validate-theme.sh",
    "package": "vsce package",
    "publish": "ovsx publish",
    "publish:vscode": "vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "Zed One Dark Local",
        "uiTheme": "vs-dark",
        "path": "./themes/onedark-zed-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "onedark-zed-icons",
        "label": "Onedark Zed Icons",
        "path": "./icons/onedark-zed-icon-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "ovsx": "^0.10.12"
  }
}
