{
  "name": "zed-onedark-vscode",
  "displayName": "Zed One Dark",
  "description": "A community-maintained VS Code port of Zed's built-in One Dark theme, with matching file icons.",
  "version": "1.3.0",
  "publisher": "NaroZeol",
  "icon": "images/icon.png",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/NaroZeol/one-dark-zed.git"
  },
  "homepage": "https://github.com/NaroZeol/one-dark-zed#readme",
  "bugs": {
    "url": "https://github.com/NaroZeol/one-dark-zed/issues"
  },
  "keywords": [
    "icon-theme",
    "theme",
    "zed-one-dark",
    "onedark",
    "onedark-zed",
    "onedark-zed-icons",
    "onedark-zed-color-theme",
    "onedark-zed-icon-theme",
    "zed-theme",
    "vscode-theme",
    "zed"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./src/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Themes"
  ],
  "galleryBanner": {
    "color": "#282c33",
    "theme": "dark"
  },
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "sync:theme": "bash scripts/apply-zed-syntax-map.sh",
    "test": "bash scripts/validate-theme.sh && node scripts/test-theme-token-colors.mjs && node scripts/test-go-import-decorations.mjs && node scripts/test-semantic-namespace-context.mjs && node scripts/test-semantic-token-contracts.mjs && node scripts/test-semantic-role-model.mjs",
    "test:textmate": "node scripts/test-theme-token-colors.mjs",
    "test:semantic:go": "node scripts/test-go-semantic-tokens.mjs",
    "test:semantic": "node scripts/test-semantic-providers.mjs && node scripts/test-go-semantic-tokens.mjs",
    "test:vscode": "node scripts/test-vscode-grammars.mjs",
    "test:all": "npm test && npm run test:semantic && npm run test:vscode",
    "package": "vsce package",
    "publish": "ovsx publish",
    "publish:vscode": "vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "Zed One Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/onedark-zed-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "onedark-zed-icons",
        "label": "Onedark Zed Icons",
        "path": "./icons/onedark-zed-icon-theme.json"
      }
    ],
    "colors": [
      {
        "id": "zedOneDark.importStringForeground",
        "description": "Foreground used to keep Go import paths visually consistent when semantic tokens overlap strings.",
        "defaults": {
          "dark": "#a1c181",
          "light": "#a1c181",
          "highContrast": "#a1c181",
          "highContrastLight": "#a1c181"
        }
      },
      {
        "id": "zedOneDark.variableForeground",
        "description": "Foreground used for namespace and module qualifiers that carry runtime values.",
        "defaults": {
          "dark": "#acb2be",
          "light": "#acb2be",
          "highContrast": "#acb2be",
          "highContrastLight": "#acb2be"
        }
      }
    ],
    "configurationDefaults": {
      "[go]": {
        "editor.semanticHighlighting.enabled": true
      },
      "gopls": {
        "ui.semanticTokens": true
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "ovsx": "^0.10.12",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
